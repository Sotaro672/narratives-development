rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function belongsToCompany(companyId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/memberUIDs/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/memberUIDs/$(request.auth.uid)
        ).data.memberId is string
        && firestore.exists(
          /databases/(default)/documents/members/$(
            firestore.get(
              /databases/(default)/documents/memberUIDs/$(request.auth.uid)
            ).data.memberId
          )
        )
        && firestore.get(
          /databases/(default)/documents/members/$(
            firestore.get(
              /databases/(default)/documents/memberUIDs/$(request.auth.uid)
            ).data.memberId
          )
        ).data.companyId is string
        && firestore.get(
          /databases/(default)/documents/members/$(
            firestore.get(
              /databases/(default)/documents/memberUIDs/$(request.auth.uid)
            ).data.memberId
          )
        ).data.companyId == companyId;
    }

    /**
     * Listの作成者であるか確認する。
     *
     * lists/{listId}.created_byには、
     * Backendで認証済みFirebase UIDが保存される。
     */
    function isListOwner(listId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/lists/$(listId)
        )
        && firestore.get(
          /databases/(default)/documents/lists/$(listId)
        ).data.created_by is string
        && firestore.get(
          /databases/(default)/documents/lists/$(listId)
        ).data.created_by == request.auth.uid;
    }

    /**
     * 全画像共通の許可MIMEタイプ。
     */
    function isAllowedImageMimeType() {
      return request.resource != null
        && request.resource.contentType is string
        && (
          request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
        );
    }

    /**
     * 全画像共通の検証。
     */
    function isValidImage(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && isAllowedImageMimeType();
    }

    /**
     * Brand icon
     * 最大2MB
     */
    match /brands/{companyId}/{brandId}/brandIcon {
      allow read: if true;

      allow create, update:
        if belongsToCompany(companyId)
        && isValidImage(2097152);

      allow delete:
        if belongsToCompany(companyId);
    }

    /**
     * Brand background image
     * 最大5MB
     */
    match /brands/{companyId}/{brandId}/brandBackgroundImage {
      allow read: if true;

      allow create, update:
        if belongsToCompany(companyId)
        && isValidImage(5242880);

      allow delete:
        if belongsToCompany(companyId);
    }

    /**
     * TokenBlueprint icon
     * 最大10MB
     */
    match /token-blueprints/{companyId}/{tokenBlueprintId}/icon/{fileName} {
      allow read:
        if belongsToCompany(companyId);

      allow create, update:
        if belongsToCompany(companyId)
        && isValidImage(10485760);

      allow delete:
        if belongsToCompany(companyId);
    }

    /**
     * TokenBlueprint image contents
     * 最大10MB
     *
     * contentsの後に、
     * contentIdとfileNameの2階層が存在する。
     */
    match /token-blueprints/{companyId}/{tokenBlueprintId}/contents/{contentId}/{fileName} {
      allow read:
        if belongsToCompany(companyId);

      allow create, update:
        if belongsToCompany(companyId)
        && isValidImage(10485760);

      allow delete:
        if belongsToCompany(companyId);
    }

    /**
     * List images
     * 最大10MB
     *
     * 保存先:
     * lists/{listId}/images/{imageId}/{fileName}
     *
     * 一覧商品画像として利用するため、readは公開する。
     * create、update、deleteはList作成者だけに許可する。
     */
    match /lists/{listId}/images/{imageId}/{fileName} {
      allow read: if true;

      allow create, update:
        if isListOwner(listId)
        && isValidImage(10485760);

      allow delete:
        if isListOwner(listId);
    }

    /**
     * 未定義パスはすべて拒否する。
     */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}