rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function belongsToCompany(companyId) {
      let memberUIDDocument = firestore.get(
        /databases/(default)/documents/memberUIDs/$(request.auth.uid)
      );

      let memberDocument = firestore.get(
        /databases/(default)/documents/members/$(memberUIDDocument.data.memberId)
      );

      return isSignedIn()
        && memberUIDDocument.data.memberId is string
        && memberDocument.data.companyId is string
        && memberDocument.data.companyId == companyId;
    }

    function isAllowedMimeType() {
      return request.resource.contentType is string
        && (
          __ALLOWED_MIME_CONDITION__
        );
    }

    function isValidBrandIcon() {
      return request.resource != null
        && request.resource.size <= __BRAND_ICON_MAX_BYTES__
        && isAllowedMimeType();
    }

    function isValidBrandBackgroundImage() {
      return request.resource != null
        && request.resource.size <= __BRAND_BACKGROUND_MAX_BYTES__
        && isAllowedMimeType();
    }

    match /brands/{companyId}/{brandId}/brandIcon {
      allow read: if true;

      allow create, update: if belongsToCompany(companyId)
        && isValidBrandIcon();

      allow delete: if belongsToCompany(companyId);
    }

    match /brands/{companyId}/{brandId}/brandBackgroundImage {
      allow read: if true;

      allow create, update: if belongsToCompany(companyId)
        && isValidBrandBackgroundImage();

      allow delete: if belongsToCompany(companyId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}