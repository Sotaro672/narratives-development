{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "deadcode": "knip",
    "duplicates": "jscpd src --min-lines 10 --min-tokens 60 --reporters console",
    "check": "npm run typecheck && npm run lint && npm run deadcode",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@solana/client": "^1.7.0",
    "@solana/react-hooks": "^1.4.1",
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.0.1",
    "@tanstack/react-query": "^5.101.4",
    "firebase": "^12.12.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jscpd": "latest",
    "knip": "latest",
    "typescript": "^5.6.2",
    "typescript-eslint": "latest",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.2.0"
  }
}